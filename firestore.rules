rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // RSVP & ucapan: semua orang boleh membaca & mengirim,
    // tapi tidak ada yang bisa mengubah / menghapus dari browser.
    match /rsvp/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'attendance', 'guests', 'message', 'hasMessage', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.attendance in ['hadir', 'tidak']
                    && request.resource.data.guests is int
                    && request.resource.data.guests >= 0
                    && request.resource.data.guests <= 10
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 500
                    && request.resource.data.hasMessage == (request.resource.data.message.size() > 0)
                    && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Selain itu tertutup
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
